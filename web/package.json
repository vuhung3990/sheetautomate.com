{
  "name": "sheetautomate-landing",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "sync": "node ../scripts/validate-flows.mjs && node ../scripts/generate-badges.mjs && node ../scripts/build-flows-manifest.mjs && node ../scripts/package-extension.mjs && node ../scripts/generate-seo-geo-assets.mjs",
    "prebuild": "npm run sync",
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "test:unit": "vitest run",
    "test:e2e": "playwright test",
    "test": "npm run test:unit && npm run test:e2e",
    "test:all": "node ../scripts/run-all-checks.mjs",
    "preflight": "node ../scripts/preflight-guard.mjs --mode=deploy"
  },
  "dependencies": {
    "canvas-confetti": "^1.9.4",
    "clsx": "^2.1.1",
    "lucide-react": "^0.475.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tailwind-merge": "^2.6.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.1",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.10",
    "@types/canvas-confetti": "^1.9.0",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "axe-core": "^4.14.0",
    "jsdom": "^31.0.1",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.7.3",
    "vite": "^6.1.0",
    "vitest": "^5.1.0"
  }
}
