  "shortDescription": "Monitor Stock_Qty against Reorder_Point, calculate suggested reorder quantities, and dispatch email digests plus optional webhook alerts.",
  "category": "Alerts & Sync",
  "tags": [
    "Inventory",
    "Low Stock",
    "Reorder Alert",
    "Webhook"
  ],
  "trigger": "Hourly / Daily Check & Sheet Menu",
  "difficulty": "Intermediate",
  "timeSavedPerWeek": "5 hrs/wk",
  "featured": true,
  "copySheetUrl": "",
  "services": [
    "Sheets",
    "Gmail",
    "Chat/Webhook"
  ],
  "setupSteps": [
    "Create an Inventory tab matching the 8-column schema and paste your SKU stock thresholds.",
    "Open Extensions -> Apps Script, paste Code.gs and appsscript.json, and save the project.",
    "Configure ALERT_RECIPIENT_EMAIL (and optional ALERT_WEBHOOK_URL) via the SheetAutomate menu, then run Check Stock Levels."
  ],
  "sheetSchema": {
    "tabName": "Inventory",
    "headers": [
      "SKU",
      "Item_Name",
      "Stock_Qty",
      "Reorder_Point",
      "Target_Stock",
      "Suggested_Reorder",
      "Alert_Status",
      "Last_Alert_Date"
    ],
